# SentinelCore Security Hub - Backend Environment Configuration

# Server Port (default 5000)
PORT=5000

# Environment mode: development | production | test
NODE_ENV=development

# CORS Allowed Origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173

# Scanner Endpoints Rate Limiting (max requests per minute per IP)
RATE_LIMIT_SCANNER_MAX=30
RATE_LIMIT_SCANNER_WINDOW_MS=60000

# General Endpoints Rate Limiting
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# Database Configuration (SQLite file path or Prisma DATABASE_URL)
DATABASE_URL="file:./data/sentinelcore.db"

